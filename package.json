{
  "name": "bagues-grupo-wolf",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/fotos/variantes.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "fondo": "node scripts/fondo/generar-duna.mjs && node scripts/fondo/rasterizar.mjs",
    "fotos": "npm run fotos:componer && npm run fotos:variantes",
    "fotos:catalogos": "node scripts/fotos/bajar-catalogos.mjs",
    "build:cliente": "vite build",
    "fondo:duna": "node scripts/fondo/generar-duna.mjs",
    "fondo:webp": "node scripts/fondo/rasterizar.mjs",
    "fotos:variantes": "node scripts/fotos/variantes.mjs",
    "fotos:componer": "node scripts/fotos/componer.mjs",
    "fotos:mascaras": "python3 scripts/fotos/mascaras.py",
    "fotos:contacto": "node scripts/fotos/contacto.mjs",
    "lint": "eslint .",
    "test": "node scripts/qa/datos.test.mjs && node scripts/qa/busqueda.test.mjs && node scripts/qa/ciclo.test.mjs && node scripts/qa/filtros.test.mjs && node scripts/qa/catalogo.test.mjs && node scripts/qa/prerender.test.mjs && node scripts/qa/historial.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lenis": "^1.3.27",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "vite": "^5.4.0"
  }
}
