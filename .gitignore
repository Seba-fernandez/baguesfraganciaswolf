node_modules
dist
.env
.env.local

# Skills de la comunidad: se reinstalan con `npx skills install` (skills-lock.json sí se versiona)
.claude/skills/
.agents/skills/
.agents/.tmp/

# Descargados crudos del pipeline de fotos: se vuelven a bajar con npm run fotos.
# Las mascaras (se calculan con rembg, que no corre en Vercel) y los avisos de
# resolucion SI se versionan.
scripts/fotos/datos/*
!scripts/fotos/datos/mascaras/
!scripts/fotos/datos/avisos.json

# Borradores de trabajo. Los scripts que sirven viven en scripts/
.tmp/
dist-ssr

# Salida del banco de pruebas (cambia en cada corrida; la linea de base si se versiona)
scripts/qa/resultado.json
__pycache__/
